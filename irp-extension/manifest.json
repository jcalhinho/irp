{
  "manifest_version": 3,
  "name": "IRP — Intent Rendering Protocol",
  "version": "1.1.0",
  "description": "Mode lecture adapté (dyslexie, FALC, basse vision) sur n'importe quel site, 100 % local ; interception IRP optionnelle.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "reader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "irp-renderer.js",
        "irp-sanitizer.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "core/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "toggle-reader": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Activer/désactiver le mode lecture adapté"
    }
  }
}